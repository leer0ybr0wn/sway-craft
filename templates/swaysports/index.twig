<!DOCTYPE html>
<html lang="en">

	{% include 'components/head' with {pageTitle: 'Sway Sports', pageSlug: 'sway-sports-home'} %}

	<body>
		<header class="mb-4">
			{% include 'components/nav' %}
			<div class="container-xl nav-margin">
				<img src="assets/img/hero-sports.jpg">
			</div>
		</header>
		
		<main>
			<section>
				<div class="container">
					<div class="scroll-controls mb-3 d-none">
						<button id="scroll-control-up" disabled>
							<img src="assets/img/chevron-up.svg" alt="up">
						</button>
					</div>

					<div class="event-container-v2">
						{% include 'components/events/events-sports-v2.twig' %}

						{% include 'components/events/events-default-v2.twig' %}
					</div>
					
					<div class="scroll-controls mt-3 d-none">
						<button id="scroll-control-down">
							<img src="assets/img/chevron-down.svg" alt="down">
						</button>
					</div>
				</div>
			</section>

			{% include 'components/content/sports.twig' %}

			{% include 'components/brand-tiles' %}
		</main>

		{% include 'components/footer' %}
	</body>
</html>
