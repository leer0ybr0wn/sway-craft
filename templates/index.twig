	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ currentSite.name }} | Home</title>
		<link rel="stylesheet" href="/css/base.css?v=0.0">
		<link rel="stylesheet" href="/css/utilities.css?v=0.0">
	</head>

	<body>
		<header>
			<nav>
				<div class="container border-bottom">
					<a href="/">
						<img class="logo" src="/assets/img/swaylondon.svg" alt="Sway London">
					</a>
				
					<ul class="main-nav">
						<li><a href="#">About</a></li>
						<li><a href="#">Events</a></li>
						<li><a href="#">Media</a></li>
						<li><a href="#">Booking</a></li>
						<li><a href="#">Contact</a></li>
					</ul>
				</div>
			</nav>

			<section class="video-container">
				<div style="width: 100%; height: 0; position: relative; padding-bottom: 42.25%">
					<iframe title="Video Player" src="//theblackarts.videomarketingplatform.co/v.ihtml/player.html?token=455c26096e5fd830be330642db3deaaf&source=embed&photo%5fid=131313133" style="width:100%; height:100%; position: absolute; top: 0; left: 0;" frameborder="0" border="0" scrolling="no" allowfullscreen allow="fullscreen">
						<p>Your web browser does not support iframes, so this video cannot play.</p>
					</iframe>
				</div>
			</section>
		</header>

		<main>
			<section>
				<div class="container py-4 border-bottom">

					<div class="event-block brand-font">
						<img src="/assets/img/swaysports.svg" alt="Sway Sports">
						<div class="event-inner">
							<div class="p-3">On at Sway Sports today</div>
							<div class="cards">
								<div class="card" style="--card-color: {{ color1 }};">
									<img src="/assets/img/temp/badge-manutd.svg" alt="Manchester United">
								</div>
								<div class="card" style="--card-color: {{ color2 }};">
									<img src="/assets/img/temp/badge-mancity.svg" alt="Manchester City">
								</div>
							</div>
							<div class="p-3">Live 8:00pm 7th Sept</div>
						</div>
						<img src="/assets/img/swaysports.svg" alt="Sway Sports">
					</div>

				</div>
			</section>

			<section>
				<div class="container text-center">
					<div class="tagline ">
						<div class="underg-times">
							<div>5 mins</div>
							<img src="/assets/img/coventgarden.svg" alt="Covent Garden">
						</div>
						<div class="brand-font">
							<h1>The Greatest Night Out In London</h1>
							<p>61 &ndash; 65 Queen Street, Covent Garden, London WC2B 5BZ</p>
						</div>
						<div class="underg-times">
							<img src="/assets/img/holborn.svg" alt="Holborn">
							<div>2 mins</div>
						</div>
					</div>
				
					<ul class="brand-list brand-font">
						<li>
							<a href="#" class="brand-tile tile-sports">
								<img src="/assets/img/swaysports.svg" alt="Sway Sports">
							</a>
							<p>Sports Bar &amp; Restaurant</p>
						</li>
						<li>
							<a href="#" class="brand-tile tile-bucenoire">
								<img src="/assets/img/bucenoire.svg" alt="Buce Noire">
							</a>
							<p>Premium Night Club &amp; Events</p>
						</li>
						<li>
							<a href="#" class="brand-tile tile-rehab">
								<img src="/assets/img/rehab.svg" alt="Rehab">
							</a>
							<p>Night Club &amp; Event Space</p>
						</li>
						<li>
							<a href="#" class="brand-tile tile-redroom">
								<img src="/assets/img/theredroom.svg" alt="The Red Room">
							</a>
							<p>Private Space</p>
						</li>
					</ul>

					<div class="private-event brand-font">
						<h2>Sway London Private Event Hire</h2>
						<p>With almost 1000 capacity, Central London's most adaptable &amp; welcoming venue.</p>
					</div>
				</div>
			</section>

			<section class="content sports">
				<div class="container">
					<div class="info-left">
						<img src="/assets/img/swaysports.svg" alt="Sway Sports" class="brand-logo">
						<div class="opentable">
							<p>Make a Booking</p>
							<img src="/assets/img/temp/opentable-placeholder.png" alt="OpenTable">
						</div>
					</div>
					<div class="info-right">
						<div>
							<h2>Sports Bar &amp; Restaurant</h2>
							<p>Holborn's ultimate destination for sports, style, and seriously good food.</p>
							<p>We've ripped up the rulebook for the traditional sports bar, creating a space that feels as chic as a Mayfair lounge, but with all the match day excitement.</p>
							<p>But we're more than a place to watch the game. We're a celebration of sport in all its forms — men's, women's, domestic, international — a home for fans, friends, and first-timers to gather, eat, play, and party in style.</p>
						</div>
						<a href="#" class="btn cta" target="_blank">Visit Sway Sports</a>
					</div>
				</div>
			</section>

