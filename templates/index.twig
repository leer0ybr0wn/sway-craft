{% set color1 = '#fff' %}
{% set color2 = '#48f' %}

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ currentSite.name }} | Home</title>
		<link rel="stylesheet" href="/css/base.css?v=0.0">
		<link rel="stylesheet" href="/css/utilities.css?v=0.0">
	</head>

	<body>
		<header>
			<nav>
				<div class="container border-bottom">
					<a href="/">
						<img class="logo" src="/assets/img/swaylondon.svg" alt="Sway London">
					</a>
				
					<ul class="main-nav">
						<li><a href="#">About</a></li>
						<li><a href="#">Events</a></li>
						<li><a href="#">Media</a></li>
						<li><a href="#">Booking</a></li>
						<li><a href="#">Contact</a></li>
					</ul>
				</div>
			</nav>

			<section class="video-container">
				<div style="width: 100%; height: 0; position: relative; padding-bottom: 42.25%">
					<iframe title="Video Player" src="//theblackarts.videomarketingplatform.co/v.ihtml/player.html?token=455c26096e5fd830be330642db3deaaf&source=embed&photo%5fid=131313133" style="width:100%; height:100%; position: absolute; top: 0; left: 0;" frameborder="0" border="0" scrolling="no" allowfullscreen allow="fullscreen">
						<p>Your web browser does not support iframes, so this video cannot play.</p>
					</iframe>
				</div>
			</section>
		</header>

		<main>
			<section class="text-center">
				<div class="container py-4 border-bottom">
					<div class="event-block">
						<img src="/assets/img/swaysports.svg" alt="Sway Sports">
						<div class="event-inner">
							<div>On at Sway Sports today</div>
							<div class="card" style="--card-color: {{ color1 }};">T1</div>
							<div class="card" style="--card-color: {{ color2 }};">T2</div>
							<div>Live 8pm 7th Sept</div>
						</div>
						<img src="/assets/img/swaysports.svg" alt="Sway Sports">
					</div>
				</div>
			</section>

			<section class="text-center">
				<div class="container py-4 let-sp">
					<div class="tagline brand-font">
						<img src="/assets/img/coventgarden.svg" alt="Covent Garden">
						<div>
							<h1>The Greatest Night Out In London</h1>
							<p>61 &ndash; 65 Queen Street, Covent Garden, London WC2B 5BZ</p>
						</div>
						<img src="/assets/img/holborn.svg" alt="Holborn">
					</div>
				
					<ul class="brand-list brand-font">
						<li>
							<a href="#" class="brand-tile tile-sports">
								<img src="/assets/img/swaysports.svg" alt="Sway Sports">
							</a>
							<p>Sports Bar &amp; Restaurant</p>
						</li>
						<li>
							<a href="#" class="brand-tile tile-bucenoire">
								<img src="/assets/img/bucenoire.svg" alt="Buce Noire">
							</a>
							<p>Premium Night Club &amp; Events</p>
						</li>
						<li>
							<a href="#" class="brand-tile tile-rehab">
								<img src="/assets/img/rehab.svg" alt="Rehab">
							</a>
							<p>Night Club &amp; Event Space</p>
						</li>
						<li>
							<a href="#" class="brand-tile tile-redroom">
								<img src="/assets/img/theredroom.svg" alt="The Red Room">
							</a>
							<p>Private Space</p>
						</li>
					</ul>

				</div>
			</section>

			<section>
				<div class="container">
					sway sports info
				</div>
			</section>

			<section>
				<div class="container">
					buce noire info
				</div>
			</section>

			<section>
				<div class="container">
					rehab info
				</div>
			</section>

			<section>
				<div class="container">
					the red room info
				</div>
			</section>

		</main>

		<footer class="text-center">
			<p>&copy; Copyright {{ "now"|date("Y") }} {{ currentSite.name }}.</p>
			<p>61 &ndash; 65 Queen Street, Covent Garden, London WC2B 5BZ</p>
		</footer>
	</body>
</html>
