<!DOCTYPE html>
<html lang="en">

	{% include 'components/head' with {pageTitle: 'The Red Room', pageSlug: 'red-room-home'} %}

	<body>
		<header class="mb-4">
			{% include 'components/nav' %}
			<div class="container-xl nav-margin">
				<img src="assets/img/hero-redroom.jpg">
			</div>
		</header>
		
		<main>
			<h1 class="container text-center">Opening Spring 2027</h1>

			<section>
				<div class="container">
					<div class="scroll-controls mb-3 d-none">
						<button id="scroll-control-up" disabled>
							<img src="assets/img/chevron-up.svg" alt="up">
						</button>
					</div>

					<div class="event-container-v2">
						{% include 'components/events/events-redroom-v2.twig' %}
					</div>

					<div class="scroll-controls mt-3 d-none">
						<button id="scroll-control-down">
							<img src="assets/img/chevron-down.svg" alt="down">
						</button>
					</div>
				</div>
			</section>

			{% include 'components/content/redroom.twig' %}

			<section>
				<div class="container-xl concepts border-bottom pb-4">
					<div>
						<img src="assets/img/redroom-concept1.jpg" alt="The Red Room concepts">
					</div>
					{# <div>
						<img src="assets/img/redroom-plan1.png" alt="The Red Room plan">
					</div> #}
				</div>
			</section>

			{% include 'components/brand-tiles' %}
		</main>

		{% include 'components/footer' %}
	</body>
</html>
