{% set brands = [
    { handle: 'default', label: 'Sway', description: 'Sway London', logo: 'swaylondon-metal-stacked.png', class: 'tile-sway' },
    { handle: 'swaySports', label: 'Sway Sports', description: 'Sports Bar & Restaurant', logo: 'swaysports.svg', class: 'tile-sports' },
    { handle: 'clubRehab', label: 'Rehab', description: 'Night Club & Event Space', logo: 'rehab.svg', class: 'tile-rehab' },
    { handle: 'buceNoire', label: 'Buce Noire', description: 'Premium Night Club & Events', logo: 'bucenoire.svg', class: 'tile-bucenoire' },
    { handle: 'redRoom', label: 'The Red Room', description: 'Private Space', logo: 'theredroom.svg', class: 'tile-redroom' },
] %}

<section>
	<div class="container">
		<ul class="brand-list brand-font text-center">
			{% for brand in brands %}
				{% set site = craft.app.sites.getSiteByHandle(brand.handle) %}

				{% if site and site.id != currentSite.id %}
					<li>
						<a href="{{ site.baseUrl }}" class="brand-tile {{ brand.class }}">
							<img src="/assets/img/{{ brand.logo }}" alt="{{ brand.label }}">
						</a>
						<p>{{ brand.description }}</p>
					</li>
				{% endif %}
			{% endfor %}
		</ul>
	</div>
</section>
