{% set color1 = '#fff' %}
{% set color2 = '#48f' %}

<section>
	<div class="container pb-4 border-bottom">
		<div class="event-container">
			<div class="event-block brand-font sports">
				<img src="/assets/img/swaysports.svg" alt="Sway Sports">
				<div class="event-inner">
					<div class="p-3">On at Sway Sports today</div>
					<div class="cards">
						<div class="card" style="--card-color: {{ color1 }};">
							<img src="/assets/img/temp/badge-manutd.svg" alt="Manchester United">
						</div>
						<div class="card" style="--card-color: {{ color2 }};">
							<img src="/assets/img/temp/badge-mancity.svg" alt="Manchester City">
						</div>
					</div>
					<div class="p-3">Live 8:00pm 7th Sept</div>
				</div>
				<img src="/assets/img/swaysports.svg" alt="Sway Sports">
			</div>

			<div class="event-block brand-font rehab">
				<img src="/assets/img/rehab.svg" alt="Enter Rehab">
				<div class="event-inner">
					<div class="p-3">Enter Rehab</div>
								
					<div class="p-3">11:00pm 10th Sept</div>
				</div>
				<img src="/assets/img/rehab.svg" alt="Enter Rehab">
			</div>

			<div class="event-block brand-font">
				<img src="/assets/img/swaysports.svg" alt="Sway Sports">
				<div class="event-inner">
					<div class="p-3">Super Sunday<br>meets Super Roast</div>
								
					<div class="p-3">Book Now</div>
				</div>
				<img src="/assets/img/swaysports.svg" alt="Sway Sports">
			</div>

			<div class="event-block brand-font bucenoire">
				<img src="/assets/img/bucenoire.svg" alt="Buce Noire">
				<div class="event-inner">
					<div class="p-3">Buce Noire Event</div>
								
					<div class="p-3">10:00pm 20th Sept</div>
				</div>
				<img src="/assets/img/bucenoire.svg" alt="Buce Noire">
			</div>
		</div>
	</div>
</section>
